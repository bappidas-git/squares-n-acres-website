APP_NAME="Squares N Acres API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The API's own origin: https://www.squaresnacres.com (Layout A) or https://api.squaresnacres.com (Layout B)
APP_URL=http://localhost:8000
# Storage and the contract are UTC; the business rules name IST where they mean it.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# The request/response trail (storage/logs/api-YYYY-MM-DD.log)
API_LOG_LEVEL=debug
API_LOG_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=squares_n_acres
DB_USERNAME=sna
DB_PASSWORD=

# Layout B only: comma-separated, explicit, never *
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000

# Bearer tokens: 24 hours; POST /auth/refresh extends the same token
SANCTUM_TOKEN_TTL_MINUTES=1440

# What sitemaps, RSS and llms.txt build absolute URLs from when seoSettings.siteUrl is empty
SITE_URL=https://www.squaresnacres.com
# true on staging: robots.txt disallows everything and every response says noindex
SEO_FORCE_NOINDEX=false

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Lead notification e-mails are queued: database + a worker, or sync
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Staging and local must not e-mail the desk: keep `log` there.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@squaresnacres.com"
MAIL_FROM_NAME="Squares N Acres"

# Laravel Debugbar (require-dev): request/response logging for every API call.
# JSON requests are stored under storage/debugbar and browsed at /_debugbar/open.
DEBUGBAR_ENABLED=true
# Also send the data to the Clockwork browser extension
DEBUGBAR_CLOCKWORK=false
