# Template for the production build. Copy it to `.env.production` (git-ignored)
# on the build machine; `npm run build` reads `.env.production`, never this file.
# `postbuild` reads the same two addresses to decide what `build/robots.txt`
# becomes — see docs/DEPLOYMENT_CLOUDWAYS.md.

# --- Layout A (recommended): one host serves the site and the API ------------
# The Laravel application answers /api/* and serves this build for every other
# path: one origin, no CORS, and robots.txt, the sitemaps, rss.xml and llms.txt
# are its routes on the crawled host. `postbuild` deletes build/robots.txt, so
# the placeholder cannot be uploaded over them.
REACT_APP_API_URL=https://www.squaresnacres.com/api
REACT_APP_SITE_URL=https://www.squaresnacres.com
REACT_APP_SITE_NAME=Squares N Acres

# --- Layout B: the site and the API on two hosts -----------------------------
# The static build on www., Laravel on api.: the API allows the site's origin
# (CORS), and `postbuild` writes build/robots.txt from the API's, with its
# Sitemap: lines on the API host. Use these two lines instead of the two above.
# REACT_APP_API_URL=https://api.squaresnacres.com/api
# REACT_APP_SITE_URL=https://www.squaresnacres.com

# Optional — leave empty to disable the feature.
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=
REACT_APP_GOOGLE_MAPS_KEY=
