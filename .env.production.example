# Template for the production build. Copy it to `.env.production` (git-ignored)
# on the build machine and fill in the optional keys that the deployment needs;
# `npm run build` reads `.env.production`, never this file.
REACT_APP_API_URL=https://api.squaresnacres.com/api
REACT_APP_SITE_URL=https://www.squaresnacres.com
REACT_APP_SITE_NAME=Squares N Acres

# Optional — leave empty to disable the feature.
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=
REACT_APP_GOOGLE_MAPS_KEY=
