# Loaded automatically by `npm start` (Create React App). Committed on purpose:
# the defaults point at the local mock server, so a fresh clone runs without a
# private `.env`. See `.env.example` for every supported variable.
REACT_APP_API_URL=http://localhost:4000/api
REACT_APP_SITE_URL=http://localhost:3000
REACT_APP_SITE_NAME=Squares N Acres
