{
  "name": "squares-n-acres-website",
  "description": "Squares N Acres — Bengaluru real-estate portal (public website + admin panel)",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=18.18",
    "npm": ">=9"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify/react": "^6.0.2",
    "@mui/material": "^7.3.8",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.5",
    "framer-motion": "^12.34.0",
    "react": "^18.2.0",
    "react-countup": "^6.5.3",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-intersection-observer": "^10.0.2",
    "react-router-dom": "^6.22.3",
    "react-scripts": "5.0.1",
    "react-slick": "^0.31.0",
    "slick-carousel": "^1.8.1",
    "sweetalert2": "^11.26.20",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.10"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "build:ci": "cross-env CI=true react-scripts build",
    "test": "react-scripts test",
    "test:ci": "cross-env CI=true react-scripts test --watchAll=false --passWithNoTests",
    "eject": "react-scripts eject",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"scripts/**/*.js\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" \"scripts/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"scripts/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\" \"scripts/**/*.js\"",
    "check:traces": "node scripts/check-traces.js",
    "check:traces:report": "node scripts/check-traces.js --report",
    "generate:brand-assets": "node scripts/fetch-brand-assets.js",
    "check:all": "npm run lint && npm run test:ci && npm run build:ci && npm run check:traces"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "prettier"
    ],
    "rules": {
      "no-console": [
        "error",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "ignoreRestSiblings": true
        }
      ],
      "react-hooks/exhaustive-deps": "error",
      "no-restricted-imports": [
        "error",
        {
          "paths": [
            {
              "name": "axios",
              "message": "Import the shared client from src/services/http.js"
            },
            {
              "name": "@mui/icons-material",
              "message": "Use @iconify/react icons"
            }
          ],
          "patterns": [
            "@mui/icons-material/*"
          ]
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "src/services/api.js",
          "src/services/http.js"
        ],
        "rules": {
          "no-restricted-imports": "off"
        }
      },
      {
        "files": [
          "scripts/**/*.js",
          "mock-server/**/*.js"
        ],
        "env": {
          "node": true
        },
        "rules": {
          "no-console": "off"
        }
      }
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(yet-another-react-lightbox)/)"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
