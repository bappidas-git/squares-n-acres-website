{
  "name": "squares-n-acres-website",
  "description": "Squares N Acres — Bengaluru real-estate portal (public website + admin panel)",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.18",
    "npm": ">=9"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iconify/react": "^6.0.2",
    "@mui/material": "^7.3.8",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-table-cell": "3.31.3",
    "@tiptap/extension-table-header": "3.31.3",
    "@tiptap/extension-table-row": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-underline": "3.31.3",
    "@tiptap/extension-youtube": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "axios": "^1.13.5",
    "dompurify": "3.4.15",
    "framer-motion": "^12.34.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.22.3",
    "react-scripts": "5.0.1",
    "recharts": "3.10.1",
    "slugify": "1.6.9",
    "web-vitals": "^2.1.4",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.22.3",
    "json-server": "^0.17.4",
    "prettier": "^3.9.6",
    "puppeteer-core": "24.43.1",
    "rimraf": "^5.0.10",
    "serve": "14.2.6"
  },
  "scripts": {
    "start": "react-scripts start",
    "mock": "node mock-server/server.js",
    "mock:reset": "node mock-server/reset.js",
    "dev": "concurrently -n mock,web -c blue,green \"npm run mock\" \"npm start\"",
    "build": "react-scripts build",
    "build:ci": "cross-env CI=true react-scripts build",
    "build:prerender": "npm run build && node scripts/prerender.js",
    "serve:build": "serve -s build -l 5000",
    "test": "react-scripts test",
    "test:ci": "cross-env CI=true react-scripts test --watchAll=false",
    "test:mock": "cd mock-server && node --test",
    "test:scripts": "node --test \"scripts/__tests__/**/*.test.js\"",
    "eject": "react-scripts eject",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"mock-server/**/*.js\" \"scripts/**/*.js\" \"e2e/**/*.js\" playwright.config.js --max-warnings=0 && node scripts/check-endpoints.js",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" \"mock-server/**/*.js\" \"scripts/**/*.js\" \"e2e/**/*.js\" playwright.config.js --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"mock-server/**/*.js\" \"scripts/**/*.js\" \"e2e/**/*.js\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\" \"mock-server/**/*.js\" \"scripts/**/*.js\" \"e2e/**/*.js\"",
    "check:traces": "node scripts/check-traces.js",
    "check:traces:report": "node scripts/check-traces.js --report",
    "validate:seed": "node scripts/validate-seed.js",
    "seed:build": "node scripts/seed/build-seed.js",
    "generate:brand-assets": "node scripts/fetch-brand-assets.js",
    "generate:backend-guidelines": "node scripts/generate-backend-guidelines.js",
    "check:all": "npm run lint && npm run test:ci && npm run test:mock && npm run test:scripts && npm run build:ci && npm run check:traces && npm run validate:seed && npm run check:contrast && npm run check:guidelines && npm run check:env",
    "check:contrast": "node scripts/contrast-check.js",
    "check:endpoints": "node scripts/check-endpoints.js",
    "check:env": "node scripts/check-env-example.js",
    "check:guidelines": "node scripts/check-guidelines.js",
    "check:links": "node scripts/check-links.js",
    "check:sitemap": "node scripts/check-sitemap-coverage.js",
    "check:jsonld": "node scripts/validate-jsonld.js",
    "smoke": "node scripts/smoke-api.js",
    "e2e": "playwright test",
    "analyze": "node scripts/bundle-report.js",
    "a11y:audit": "node scripts/a11y-audit.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "prettier"
    ],
    "rules": {
      "no-console": [
        "error",
        {
          "allow": [
            "warn",
            "error"
          ]
        }
      ],
      "no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "ignoreRestSiblings": true
        }
      ],
      "react-hooks/exhaustive-deps": "error",
      "no-restricted-imports": [
        "error",
        {
          "paths": [
            {
              "name": "axios",
              "message": "Import the shared client from src/services/http.js"
            },
            {
              "name": "@mui/icons-material",
              "message": "Use @iconify/react icons"
            }
          ],
          "patterns": [
            "@mui/icons-material/*"
          ]
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "src/services/http.js"
        ],
        "rules": {
          "no-restricted-imports": "off"
        }
      },
      {
        "files": [
          "scripts/**/*.js",
          "mock-server/**/*.js"
        ],
        "env": {
          "node": true
        },
        "rules": {
          "no-console": "off"
        }
      },
      {
        "files": [
          "e2e/**/*.js",
          "playwright.config.js"
        ],
        "env": {
          "node": true
        },
        "rules": {
          "no-console": "off",
          "testing-library/await-async-queries": "off",
          "testing-library/await-async-utils": "off",
          "testing-library/no-await-sync-queries": "off",
          "testing-library/no-container": "off",
          "testing-library/no-debugging-utils": "off",
          "testing-library/no-dom-import": "off",
          "testing-library/no-node-access": "off",
          "testing-library/no-promise-in-fire-event": "off",
          "testing-library/no-render-in-setup": "off",
          "testing-library/no-unnecessary-act": "off",
          "testing-library/no-wait-for-multiple-assertions": "off",
          "testing-library/no-wait-for-side-effects": "off",
          "testing-library/no-wait-for-snapshot": "off",
          "testing-library/prefer-find-by": "off",
          "testing-library/prefer-presence-queries": "off",
          "testing-library/prefer-query-by-disappearance": "off",
          "testing-library/prefer-screen-queries": "off",
          "testing-library/render-result-naming-convention": "off",
          "no-empty-pattern": "off"
        }
      }
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(yet-another-react-lightbox|@iconify/react|@tiptap)/)"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
