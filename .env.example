# Squares N Acres — environment variables
#
# Copy this file to `.env` and adjust the values for your machine:
#   cp .env.example .env            (macOS/Linux)
#   copy .env.example .env          (Windows)
#
# A copy is optional for local development: `.env.development` is committed and
# is loaded automatically by `npm start`. Variables prefixed `REACT_APP_` are
# embedded into the bundle at build time; the `MOCK_*` variables are read by the
# mock server (Node) at runtime.

# --- Required ---------------------------------------------------------------

# Base URL of the API, including the `/api` suffix. Points at the local mock
# server by default; set it to the Laravel API to switch backends. The app
# throws at startup when this is missing — there is no fallback URL.
REACT_APP_API_URL=http://localhost:4000/api

# Public origin of the site, without a trailing slash. Used for canonical URLs,
# Open Graph tags and sitemaps until the API provides `seoSettings.siteUrl`.
REACT_APP_SITE_URL=http://localhost:3000

# Display name of the site, used as the fallback for `SITE.name`.
REACT_APP_SITE_NAME=Squares N Acres

# --- Optional ---------------------------------------------------------------

# Cloudinary cloud name — enables image uploads from the admin media library.
REACT_APP_CLOUDINARY_CLOUD_NAME=

# Cloudinary unsigned upload preset, required together with the cloud name.
REACT_APP_CLOUDINARY_UPLOAD_PRESET=

# Google Maps JavaScript API key — enables the property location map.
REACT_APP_GOOGLE_MAPS_KEY=

# Absolute path to a Chrome/Chromium binary for the prerender script.
CHROME_PATH=

# --- Mock server (Node, not embedded in the bundle) -------------------------

# Port the mock server listens on; must match the host in REACT_APP_API_URL.
MOCK_PORT=4000

# Artificial latency in milliseconds added to every mock response.
MOCK_DELAY_MS=0

# Lifetime in hours of a mock auth token.
MOCK_TOKEN_TTL_HOURS=24

# Set to 1 to re-seed the runtime database from `db.json` on every start.
MOCK_FRESH=0
